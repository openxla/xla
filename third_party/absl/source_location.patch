#
# Add ABSL_NO_STD_SOURCE_LOCATION, an opt-out for std::source_location
# detection.
#
# This patch does not change behaviour on its own: a build that does not define
# ABSL_NO_STD_SOURCE_LOCATION keeps upstream's detection exactly as-is. Only
# config `rocm_base` defines it (see tensorflow.bazelrc).
#
# Abseil infers std::source_location from the language version plus
# __has_include(<source_location>). That inference is wrong for the ROCm
# toolchain, which compiles at C++20 (`common:linux --cxxopt=-std=c++20`)
# against the sysroot's libstdc++ -- libstdc++ 10 in linux_glibc_2_31, and
# std::source_location only landed in libstdc++ 11. __has_include still
# succeeds because ROCm's own bundled libc++ headers
# (rocm_dist/lib/llvm/include/c++/v1/source_location) are on the include path,
# so Abseil concludes the type exists when the standard library in use does not
# provide it:
#
#   absl/types/source_location.h:63:24: error: no type named 'source_location'
#   in namespace 'std'; did you mean 'std::experimental::source_location'?
#
# ABSL_HAVE_STD_SOURCE_LOCATION is the right knob rather than
# ABSL_OPTION_USE_STD_SOURCE_LOCATION: the option only controls the
# `using SourceLocation = std::source_location` alias at source_location.h:63,
# while source_location.h:88 declares a converting constructor from
# std::source_location gated on ABSL_HAVE_* alone. Those two are the only
# non-test uses of the type, so clearing ABSL_HAVE_* covers both -- and it also
# leaves ABSL_USES_STD_SOURCE_LOCATION undefined on its own, since option 2
# resolves to "not used" when ABSL_HAVE_* is absent.
#
# config.h rejects setting ABSL_HAVE_STD_SOURCE_LOCATION directly (it is a
# detection result, not an input), hence the separate opt-out macro.
#
# It has to be defined for every TU -- target and exec -- so that
# absl::SourceLocation is one type across everything that links together;
# mixing would give it two layouts and two mangled names.
#
# Drop both the patch and the define once the ROCm build uses a standard
# library that actually has std::source_location.
diff --git a/absl/base/config.h b/absl/base/config.h
--- a/absl/base/config.h
+++ b/absl/base/config.h
@@ -534,8 +534,11 @@
 // ABSL_HAVE_STD_SOURCE_LOCATION
 //
 // Checks whether C++20 std::source_location is available.
 #ifdef ABSL_HAVE_STD_SOURCE_LOCATION
 #error "ABSL_HAVE_STD_SOURCE_LOCATION cannot be directly set."
+#elif defined(ABSL_NO_STD_SOURCE_LOCATION)
+// Detection forced off by the build; the standard library in use does not
+// provide std::source_location even though <source_location> is includable.
 #elif (defined(__cpp_lib_source_location) &&    \
        __cpp_lib_source_location >= 201907L) || \
     (defined(ABSL_INTERNAL_CPLUSPLUS_LANG) &&   \
