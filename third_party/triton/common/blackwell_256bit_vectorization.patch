Allows 256-bit vectorization on NVIDIA Blackwell (sm_100+) architectures.

Enables 256-bit vectorization in pickDescriptorLoadStoreLayout (Coalesce.cpp)
and getMaxElementsPerThread (Utility.cpp) when targeting compute capability >= 100.

--- a/lib/Dialect/TritonGPU/Transforms/Coalesce.cpp
+++ b/lib/Dialect/TritonGPU/Transforms/Coalesce.cpp
@@ -26,15 +26,20 @@
 // Descriptor load/stores don't need to consider L1 coalescing but the
 // destination layout will affect the shared memory load/store generated. So we
 // still want to allow vectorization for the src/destination layout up to
-// 16bytes.
+// 16bytes (or 32bytes on sm_100+).
 static Attribute pickDescriptorLoadStoreLayout(int numWarps, int threadsPerWarp,
-                                               RankedTensorType type) {
+                                               RankedTensorType type,
+                                               int computeCapability = 0) {
   auto shapePerCTA = triton::gpu::getShapePerCTA(type);
   int numElems = product<int64_t>(shapePerCTA);
   int numThreads = numWarps * threadsPerWarp;
   int numElemsPerThread = std::max(numElems / numThreads, 1);
 
-  int maxVectorSize = 128 / getIntOrFloatOrPtrBitWidth(type.getElementType());
+  // On Blackwell (sm_100+), allow up to 256-bit vectorization for descriptor
+  // load/store layout to support 2D TMA transfers.
+  int maxVectorBits = (computeCapability >= 100) ? 256 : 128;
+  int maxVectorSize =
+      maxVectorBits / getIntOrFloatOrPtrBitWidth(type.getElementType());
 
   int vectorSize = std::min(numElemsPerThread, maxVectorSize);
   SmallVector<unsigned> sizePerThread(type.getRank(), 1);
@@ -53,17 +58,26 @@
 static void pickDescriptorLoadStoreLayout(
     ModuleOp moduleOp, llvm::MapVector<Operation *, Attribute> &layoutMap) {
   int threadsPerWarp = TritonGPUDialect::getThreadsPerWarp(moduleOp);
+  int computeCapability = 0;
+  if (auto targetAttr =
+          moduleOp->getAttrOfType<StringAttr>(triton::gpu::AttrTargetName);
+      targetAttr && targetAttr.getValue().starts_with("cuda:")) {
+    computeCapability = getNVIDIAComputeCapability(moduleOp);
+  }
   moduleOp.walk([&](Operation *op) {
     int numWarps = lookupNumWarps(op);
     if (auto load = dyn_cast<DescriptorOpInterface>(op)) {
-      if (load->getNumResults() == 1)
+      if (load->getNumResults() == 1) {
         layoutMap[op] = pickDescriptorLoadStoreLayout(
             numWarps, threadsPerWarp,
-            cast<RankedTensorType>(load->getResult(0).getType()));
+            cast<RankedTensorType>(load->getResult(0).getType()),
+            computeCapability);
+      }
     }
     if (auto store = dyn_cast<DescriptorStoreLikeOpInterface>(op)) {
-      layoutMap[op] = pickDescriptorLoadStoreLayout(numWarps, threadsPerWarp,
-                                                    store.getSrc().getType());
+      layoutMap[op] = pickDescriptorLoadStoreLayout(
+          numWarps, threadsPerWarp, store.getSrc().getType(),
+          computeCapability);
     }
   });
 }

--- a/lib/Dialect/TritonGPU/Transforms/Utility.cpp
+++ b/lib/Dialect/TritonGPU/Transforms/Utility.cpp
@@ -170,8 +170,23 @@
   // exposes the target architecture but not the PTX version, so we only cap
   // cases that are unambiguous from the available target metadata and the
   // current backend lowering.
+  //
+  // On Blackwell (sm_100+), LLVM NVPTX supports 256-bit global ld/st with
+  // PTX 8.8+. Because the PTX version is not queryable from TTGIR module
+  // metadata at this stage, we assume a compatible PTX version (>= 8.8) when
+  // targeting compute capability >= 100.
+  unsigned maxBits = 128;
+  if (auto mod = op->getParentOfType<ModuleOp>()) {
+    if (auto targetAttr =
+            mod->getAttrOfType<StringAttr>(triton::gpu::AttrTargetName);
+        targetAttr && targetAttr.getValue().starts_with("cuda:")) {
+      if (getNVIDIAComputeCapability(mod) >= 100) {
+        maxBits = 256;
+      }
+    }
+  }
   return getAtomicElementsPerThreadCap(op, elemNumBits)
-      .value_or(128 / elemNumBits);
+      .value_or(maxBits / elemNumBits);
 }
 
