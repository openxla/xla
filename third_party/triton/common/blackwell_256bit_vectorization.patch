+// -----
+
+// CHECK: [[$VEC_GLOBAL_SM90:#.*]] = #ttg.blocked<{sizePerThread = [4], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
+// CHECK: [[$VEC_DESC_SM90:#.*]] = #ttg.blocked<{sizePerThread = [1, 8], threadsPerWarp = [2, 16], warpsPerCTA = [4, 1], order = [1, 0]}>
+#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0]}>
+#blocked2d = #ttg.blocked<{sizePerThread = [1, 1], threadsPerWarp = [1, 32], warpsPerCTA = [2, 2], order = [1, 0]}>
+module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "cuda:90", "ttg.threads-per-warp" = 32 : i32} {
+  // CHECK-LABEL: @vec256_global_and_desc_sm90
+  tt.func public @vec256_global_and_desc_sm90(%arg0: !tt.ptr<f32> {tt.divisibility = 32 : i32}, %arg1: !tt.tensordesc<16x128xf16>) {
+    %c1024_i32 = arith.constant 1024 : i32
+    %c0_i32 = arith.constant 0 : i32
+    %0 = tt.get_program_id x : i32
+    %1 = arith.muli %0, %c1024_i32 : i32
+    %2 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32, #blocked>
+    %3 = tt.splat %1 : i32 -> tensor<1024xi32, #blocked>
+    %4 = arith.addi %3, %2 : tensor<1024xi32, #blocked>
+    %5 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>, #blocked>
+    %6 = tt.addptr %5, %4 : tensor<1024x!tt.ptr<f32>, #blocked>, tensor<1024xi32, #blocked>
+    // CHECK: tt.load {{.*}} : tensor<1024x!tt.ptr<f32>, [[$VEC_GLOBAL_SM90]]>
+    %7 = tt.load %6 : tensor<1024x!tt.ptr<f32>, #blocked>
+
+    %cst = arith.constant dense<0.000000e+00> : tensor<16x128xf16, #blocked2d>
+    // CHECK: tt.descriptor_store {{.*}} : !tt.tensordesc<16x128xf16>, tensor<16x128xf16, [[$VEC_DESC_SM90]]>
+    tt.descriptor_store %arg1[%c0_i32, %c0_i32], %cst : !tt.tensordesc<16x128xf16>, tensor<16x128xf16, #blocked2d>
+    tt.return
+  }
+}
