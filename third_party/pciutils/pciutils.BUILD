# Overlay BUILD for @pciutils. Builds libpci (pciutils) from source as a
# static, hidden-visibility cc_library so that MORI's
# src/application/topology/pci.cpp can both compile (it includes <pci/pci.h>
# and calls pci_alloc / pci_init / pci_scan_bus / pci_fill_info /
# pci_read_byte / pci_cleanup) AND link hermetically.
#
# This replaces the previous @system_libpci repository rule, which probed the
# ROCm CI image's /usr/include at fetch time. Pinning to a source tarball makes
# the build reproducible and independent of whatever pciutils happens to be
# installed in the container.
#
# Previously only the headers were vendored and libpci.so was linked from the
# host via -lpci. That does not work in a "rocm-less" hermetic image (no
# libpci-dev), so we now compile a minimal Linux (sysfs/proc) libpci from the
# vendored sources. It is linked statically into MORI with hidden visibility so
# its pci_* symbols can never clash with / interpose a system libpci.so that
# might also be present in the process.
#
# lib/config.h is normally generated by pciutils' ./configure; we supply a
# hand-written replacement (see //third_party/pciutils:config.h), symlinked
# into place by tf_http_archive's link_files. It selects a dependency-free
# config (no DNS/hwdb/zlib), so the static lib needs nothing but libc.

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # GPL-2.0-or-later (pciutils)

exports_files(["COPYING"])

# Static libpci built from source. Source list mirrors the base OBJS in
# lib/Makefile plus the Linux sysfs/proc access methods; the BSD/Win/Darwin/
# mmio/ecam/i386-ports/physmem backends are intentionally excluded (not
# referenced under the config.h settings). names-net / names-hwdb / names-parse
# compile to dependency-free stubs because PCI_USE_DNS / PCI_HAVE_HWDB /
# PCI_COMPRESSED_IDS are left undefined.
cc_library(
    name = "pci",
    srcs = [
        "lib/init.c",
        "lib/access.c",
        "lib/generic.c",
        "lib/dump.c",
        "lib/names.c",
        "lib/names-hash.c",
        "lib/names-parse.c",
        "lib/names-net.c",
        "lib/names-cache.c",
        "lib/names-hwdb.c",
        "lib/filter.c",
        "lib/params.c",
        "lib/caps.c",
        "lib/sysfs.c",
        "lib/proc.c",
    ] + glob(["lib/*.h"]),
    copts = [
        # External code: silence warnings (external/.*@-w already does this, but
        # be explicit) and keep pci_* symbols private to avoid interposition.
        "-w",
        "-fvisibility=hidden",
        "-D_GNU_SOURCE",
    ],
    # The lib/*.c sources use quote-includes ("internal.h", "pci.h", ...) that
    # resolve within lib/.
    includes = ["lib"],
    linkstatic = True,
    visibility = ["//visibility:public"],
)

# Public libpci headers, remapped so they resolve as <pci/pci.h>.
# pci.h #includes "config.h", "header.h" and "types.h" by quote; all four live
# in lib/ and are re-rooted under pci/ by strip_include_prefix/include_prefix,
# so the quote includes keep resolving next to pci.h.
cc_library(
    name = "pci_headers",
    hdrs = [
        "lib/config.h",
        "lib/header.h",
        "lib/pci.h",
        "lib/types.h",
    ],
    include_prefix = "pci",
    strip_include_prefix = "lib",
    visibility = ["//visibility:public"],
)
