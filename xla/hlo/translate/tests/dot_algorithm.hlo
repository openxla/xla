// RUN: hlo-translate -hlo-to-mlir %s | FileCheck %s
// RUN: hlo-translate -hlo-to-mlir %s | hlo-translate -mlir-to-hlo | FileCheck %s --check-prefix=ROUNDTRIP

// A 2-D default dot with an explicit algorithm must import as
// stablehlo.dot_general (since stablehlo.dot has no algorithm field) so the
// algorithm survives HLO -> StableHLO -> HLO round-trip.

HloModule dot_2d_default_algorithms, entry_computation_layout={(f32[4,4]{1,0}, f32[4,4]{1,0})->(f32[4,4]{1,0}, f32[4,4]{1,0})}

// CHECK-LABEL: module @dot_2d_default_algorithms
// CHECK:       stablehlo.dot_general
// CHECK-SAME:  algorithm = <lhs_precision_type = f32, rhs_precision_type = f32, accumulation_type = f32, lhs_component_count = 1, rhs_component_count = 1, num_primitive_operations = 1, allow_imprecise_accumulation = false>
// CHECK:       stablehlo.dot_general
// CHECK-SAME:  algorithm = <lhs_precision_type = bf16, rhs_precision_type = bf16, accumulation_type = f32, lhs_component_count = 1, rhs_component_count = 1, num_primitive_operations = 9, allow_imprecise_accumulation = false>

// ROUNDTRIP-LABEL: HloModule dot_2d_default_algorithms
// ROUNDTRIP:       f32[4,4] dot({{.*}}), lhs_contracting_dims={1}, rhs_contracting_dims={0}, algorithm=dot_f32_f32_f32
// ROUNDTRIP:       f32[4,4] dot({{.*}}), lhs_contracting_dims={1}, rhs_contracting_dims={0}, algorithm=dot_bf16_bf16_f32_x9
ENTRY %main (a: f32[4,4], b: f32[4,4]) -> (f32[4,4], f32[4,4]) {
  %a = f32[4,4]{1,0} parameter(0)
  %b = f32[4,4]{1,0} parameter(1)
  %dot_f32 = f32[4,4]{1,0} dot(%a, %b), lhs_contracting_dims={1}, rhs_contracting_dims={0}, algorithm=dot_f32_f32_f32
  %dot_x9 = f32[4,4]{1,0} dot(%a, %b), lhs_contracting_dims={1}, rhs_contracting_dims={0}, algorithm=dot_bf16_bf16_f32_x9
  ROOT %tuple = (f32[4,4]{1,0}, f32[4,4]{1,0}) tuple(%dot_f32, %dot_x9)
}
