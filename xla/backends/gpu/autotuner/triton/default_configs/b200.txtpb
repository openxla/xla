config { block_m: 16 block_n: 16 block_k: 128 num_stages: 1 num_warps: 2 num_ctas: 1 }
config { block_m: 32 block_n: 16 block_k: 64 num_stages: 3 num_warps: 2 num_ctas: 1 }
config { block_m: 32 block_n: 16 block_k: 256 num_stages: 3 num_warps: 2 num_ctas: 1 }
config { block_m: 32 block_n: 32 block_k: 32 num_stages: 4 num_warps: 2 num_ctas: 1 }
config { block_m: 64 block_n: 16 block_k: 128 num_stages: 3 num_warps: 2 num_ctas: 1 is_tma_allowed: true }
config { block_m: 64 block_n: 16 block_k: 128 num_stages: 3 num_warps: 4 num_ctas: 1 }
config { block_m: 64 block_n: 16 block_k: 256 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 64 block_n: 16 block_k: 128 num_stages: 3 num_warps: 4 num_ctas: 1 }
config { block_m: 64 block_n: 32 block_k: 64 num_stages: 1 num_warps: 2 num_ctas: 1 is_tma_allowed: true }
config { block_m: 64 block_n: 64 block_k: 16 num_stages: 1 num_warps: 32 num_ctas: 1 }
config { block_m: 64 block_n: 64 block_k: 64 num_stages: 1 num_warps: 2 num_ctas: 1 is_tma_allowed: true }
config { block_m: 64 block_n: 64 block_k: 128 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
# 4- and 5-stage TMA for narrow-activation (`block_n = 64`) GEMMs with K-minor
# weights and wide-K (`block_k = 256`) tiles unlocked for mixed-precision dots.
config { block_m: 64 block_n: 64 block_k: 128 num_stages: 4 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 64 block_n: 128 block_k: 16 num_stages: 3 num_warps: 2 num_ctas: 1 }
config { block_m: 64 block_n: 128 block_k: 64 num_stages: 4 num_warps: 4 num_ctas: 1 }
config { block_m: 64 block_n: 128 block_k: 64 num_stages: 5 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 16 block_k: 256 num_stages: 2 num_warps: 4 num_ctas: 1 }
config { block_m: 128 block_n: 16 block_k: 128 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 32 block_k: 64 num_stages: 3 num_warps: 4 num_ctas: 1 }
config { block_m: 128 block_n: 32 block_k: 64 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
# 5 stages: bf16 4 * 24 KiB = 96 KiB.
config { block_m: 128 block_n: 64 block_k: 64 num_stages: 5 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 64 block_k: 128 num_stages: 3 num_warps: 4 num_ctas: 1 }
config { block_m: 128 block_n: 64 block_k: 128 num_stages: 4 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
# 5 stages: bf16 4 * 48 KiB = 192 KiB, w8 4 * 32 KiB = 128 KiB.
config { block_m: 128 block_n: 64 block_k: 128 num_stages: 5 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
# Wide K, w8 only: w8 3 * 64 KiB = 192 KiB (bf16 would need 288 KiB).
config { block_m: 128 block_n: 64 block_k: 256 num_stages: 4 num_warps: 8 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 128 block_k: 64 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 128 block_k: 64 num_stages: 4 num_warps: 4 num_ctas: 1 }
config { block_m: 128 block_n: 128 block_k: 128 num_stages: 1 num_warps: 8 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 128 block_k: 128 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 128 block_k: 256 num_stages: 1 num_warps: 8 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 256 block_k: 16 num_stages: 4 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 256 block_k: 32 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 256 block_k: 32 num_stages: 3 num_warps: 8 num_ctas: 1 }
config { block_m: 128 block_n: 256 block_k: 32 num_stages: 4 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 256 block_k: 64 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 128 block_n: 256 block_k: 64 num_stages: 3 num_warps: 8 num_ctas: 1 }
config { block_m: 128 block_n: 256 block_k: 64 num_stages: 4 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 256 block_n: 16 block_k: 32 num_stages: 3 num_warps: 2 num_ctas: 1 }
config { block_m: 256 block_n: 16 block_k: 64 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 256 block_n: 16 block_k: 64 num_stages: 4 num_warps: 4 num_ctas: 1 }
config { block_m: 256 block_n: 64 block_k: 64 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 256 block_n: 64 block_k: 128 num_stages: 3 num_warps: 4 num_ctas: 1 is_tma_allowed: true }
config { block_m: 256 block_n: 128 block_k: 32 num_stages: 5 num_warps: 8 num_ctas: 1 is_tma_allowed: true }
config { block_m: 256 block_n: 256 block_k: 32 num_stages: 3 num_warps: 8 num_ctas: 1 }
config { block_m: 256 block_n: 256 block_k: 32 num_stages: 5 num_warps: 8 num_ctas: 1 is_tma_allowed: true }
