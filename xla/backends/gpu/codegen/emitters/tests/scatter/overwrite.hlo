// RUN: gpu_fusion_to_mlir %s | emitters_opt -xla-test-optimize |\
// RUN:   FileCheck %s
// RUN: gpu_fusion_to_mlir %s | emitters_opt -xla-test-optimize \
// RUN:   -xla-gpu-test-transform-loops -xla-gpu-test-to-llvm |\
// RUN:   FileCheck %s --check-prefix=CHECK-LLVM
// RUN: gpu_test_correctness %s

overwrite {
  %p0 = f32[] parameter(0)
  ROOT %p1 = f32[] parameter(1)
}
scatter {
  %operand = f32[10,5]  parameter(0)
  %indices = s32[3,1] constant({{1}, {3}, {5}})
  %update = f32[3,2,3] parameter(1)

  ROOT %scatter = f32[10,5] scatter(
      f32[10,5] %operand,
      s32[3,1] %indices,
      f32[3,2,3] %update
    ),
    update_window_dims={1,2},
    inserted_window_dims={},
    scatter_dims_to_operand_dims={0},
    index_vector_dim=1,
    unique_indices=false,
    to_apply=overwrite
}
// CHECK-LABEL: func.func @main(
// CHECK-SAME:    %[[OPERAND:[a-zA-Z0-9]*]]: tensor<10x5xf32>

// CHECK-SAME:    %[[UPDATES:[a-zA-Z0-9]*]]: tensor<3x2x3xf32>
// CHECK-SAME:    %[[OUT:[a-zA-Z0-9]*]]: tensor<10x5xf32>

// CHECK: %[[IN_BOUNDS:.*]] = arith.cmpi ule
// CHECK: scf.if %[[IN_BOUNDS]] -> (tensor<10x5xf32>) {
// CHECK:   %[[UPD_ELEM:.*]] = xla.pure_call @scatter_update
// CHECK:   %[[STORE:.*]] = xla.atomic_store %[[UPD_ELEM]] into %{{[a-z0-9]+}}
// CHECK:   xla.yield %[[STORE]] : tensor<10x5xf32>

// CHECK-LLVM-LABEL: llvm.func @main
// CHECK-LLVM-NOT: llvm.cmpxchg
// CHECK-LLVM: llvm.store %{{.*}}, %{{.*}} atomic unordered <alignment = 4>
// CHECK-LLVM-NOT: llvm.cmpxchg
