// RUN: fusion_to_triton %s | FileCheck %s

sum {
  x = f32[] parameter(0)
  y = f32[] parameter(1)
  ROOT add = f32[] add(x, y)
}
fusion{
  p0 = f32[65536]{0} parameter(0)
  ROOT all-reduce = f32[65536]{0} all-reduce(p0),
    replica_groups={{0,1}}, to_apply=sum,
    backend_config={"collective_backend_config":{"kernel_strategy":"KERNEL_STRATEGY_TRITON_ONE_SHOT"}}
}

// CHECK-LABEL: xtile.entry_func @triton_fn(
// CHECK-SAME:    %[[ARG0:[a-zA-Z0-9_]+]]: memref<65536xf32>,
// CHECK-SAME:    %[[ARG1:[a-zA-Z0-9_]+]]: memref<65536xf32>,
// CHECK-SAME:    %[[REMOTE:[a-zA-Z0-9_]+]]: memref<2xi64>,
// CHECK-SAME:    %[[SIGNAL:[a-zA-Z0-9_]+]]: memref<2xi64>,
// CHECK-SAME:    %[[RANK_IDX:[a-zA-Z0-9_]+]]: index {xla.range = [0 : index, 1 : index]},
// CHECK-SAME:    %[[PID:[a-zA-Z0-9_]+]]: index{{( \{xla.range = \[0 : index, 15 : index\]\})?}})
// CHECK-SAME:    attributes {has_rank, has_signal_buffer, num_scratch_buffers = 1 : i32} {
// CHECK-DAG:    %[[C1:.*]] = arith.constant 1 : i32
// CHECK-DAG:    %[[WORLD_SIZE:.*]] = arith.constant 2 : i32
// CHECK-DAG:    %[[C1_I64:.*]] = arith.constant 1 : i64
// CHECK-DAG:    %[[SLOT_STRIDE:.*]] = arith.constant 65536 : i64
// CHECK-DAG:    %[[BUF_STRIDE:.*]] = arith.constant 131072 : i64

// CHECK:        %[[EXTRACT_0:.*]] = xtile.extract
// CHECK-SAME:     : memref<65536xf32> -> tensor<4096xf32>

// The signal value is derived from this block's own slot in the local signal
// buffer (`SignalBuffers[rank][block_id * world_size + rank]`).
// CHECK:        %[[RANK:.*]] = arith.index_cast %[[RANK_IDX]] : index to i32
// CHECK:        %[[BLOCK_ID:.*]] = tt.get_program_id x
// CHECK:        %[[SIGNAL_PTR:.*]] = triton_xla.memref_to_ptr %[[SIGNAL]]
// CHECK:        %[[SIGNAL_BUFFER_ADDR:.*]] = tt.addptr %[[SIGNAL_PTR]], %[[RANK]]
// CHECK:        %[[SIGNAL_BUFFER_INT:.*]] = tt.load %[[SIGNAL_BUFFER_ADDR]]
// CHECK:        %[[SIGNAL_BUFFER:.*]] = tt.int_to_ptr %[[SIGNAL_BUFFER_INT]]
// CHECK:        %[[BLOCK_OFFSET:.*]] = arith.muli %[[BLOCK_ID]], %[[WORLD_SIZE]]
// CHECK:        %[[COUNTER_IDX:.*]] = arith.addi %[[BLOCK_OFFSET]], %[[RANK]]
// CHECK:        %[[COUNTER_PTR:.*]] = tt.addptr %[[SIGNAL_BUFFER]], %[[COUNTER_IDX]]
// CHECK:        %[[COUNTER:.*]] = tt.load %[[COUNTER_PTR]] {isVolatile = true}
// CHECK:        %[[SIGNAL_VALUE:.*]] = arith.addi %[[COUNTER]], %[[C1]]

// Double-buffer offset uses `world_size` aligned slots per half (2 * 65536).
// CHECK:        %[[SIGNAL_I64:.*]] = arith.extsi %[[SIGNAL_VALUE]] : i32 to i64
// CHECK:        %[[BUF_IDX:.*]] = arith.andi %[[SIGNAL_I64]], %[[C1_I64]] : i64
// CHECK:        %[[BUF_OFFSET:.*]] = arith.muli %[[BUF_IDX]], %[[BUF_STRIDE]] : i64

// Push local tile to peer's symmetric buffer (slot = rank), then local rank's
// symmetric buffer (slot = rank).
// CHECK:        %[[RANK_I64:.*]] = arith.extui %[[RANK]] : i32 to i64
// CHECK:        %[[SLOT_OFFSET:.*]] = arith.muli %[[RANK_I64]], %[[SLOT_STRIDE]] : i64
// CHECK:        %[[WRITE_OFFSET:.*]] = arith.addi %[[BUF_OFFSET]], %[[SLOT_OFFSET]] : i64
// CHECK:        %[[PEER_SUM:.*]] = arith.addi %[[RANK]], %[[C1]] : i32
// CHECK:        %[[PEER_RANK:.*]] = arith.remui %[[PEER_SUM]], %[[WORLD_SIZE]] : i32
// CHECK-DAG:    %[[PEER_IDX:.*]] = arith.index_cast %[[PEER_RANK]] : i32 to index
// CHECK-DAG:    %[[WRITE_OFFSET_IDX:.*]] = arith.index_cast %[[WRITE_OFFSET]] : i64 to index
// CHECK:        %[[PEER_MEMREF:.*]] = xtile.select_buffer %[[REMOTE]][%[[PEER_IDX]]] offset %[[WRITE_OFFSET_IDX]] : memref<2xi64> -> memref<65536xf32>
// CHECK:        xtile.insert %[[EXTRACT_0]] into %[[PEER_MEMREF]]
// CHECK-SAME:     : tensor<4096xf32> -> memref<65536xf32>
// CHECK:        %[[LOCAL_MEMREF:.*]] = xtile.select_buffer %[[REMOTE]][%[[RANK_IDX]]] offset %[[WRITE_OFFSET_IDX]] : memref<2xi64> -> memref<65536xf32>
// CHECK:        xtile.insert %[[EXTRACT_0]] into %[[LOCAL_MEMREF]]
// CHECK-SAME:     : tensor<4096xf32> -> memref<65536xf32>

// CHECK:        ttg.barrier local
// CHECK:        triton_xla.block_barrier %[[SIGNAL_PTR]], %[[RANK]], %[[SIGNAL_VALUE]]
// CHECK-SAME:    <world_size = 2> : (!tt.ptr<i64>, i32, i32)

// Reduce locally by reading both slots from this rank's own symmetric buffer.
// CHECK:        %[[SLOT0_OFFSET_IDX:.*]] = arith.index_cast %[[BUF_OFFSET]] : i64 to index
// CHECK:        %[[SLOT0:.*]] = xtile.select_buffer %[[REMOTE]][%[[RANK_IDX]]] offset %[[SLOT0_OFFSET_IDX]] : memref<2xi64> -> memref<65536xf32>
// CHECK:        %[[TILE0:.*]] = xtile.extract %[[SLOT0]]
// CHECK-SAME:     : memref<65536xf32> -> tensor<4096xf32>
// CHECK:        %[[SLOT1_OFFSET:.*]] = arith.addi %[[BUF_OFFSET]], %[[SLOT_STRIDE]] : i64
// CHECK:        %[[SLOT1_OFFSET_IDX:.*]] = arith.index_cast %[[SLOT1_OFFSET]] : i64 to index
// CHECK:        %[[SLOT1:.*]] = xtile.select_buffer %[[REMOTE]][%[[RANK_IDX]]] offset %[[SLOT1_OFFSET_IDX]] : memref<2xi64> -> memref<65536xf32>
// CHECK:        %[[TILE1:.*]] = xtile.extract %[[SLOT1]]
// CHECK-SAME:     : memref<65536xf32> -> tensor<4096xf32>
// CHECK:        %[[REDUCED:.*]] = arith.addf %[[TILE0]], %[[TILE1]] : tensor<4096xf32>

// CHECK:        xtile.insert %[[REDUCED]] into %[[ARG1]]
// CHECK-SAME:     : tensor<4096xf32> -> memref<65536xf32>


ENTRY entry {
  p0 = f32[65536]{0} parameter(0)
  ROOT fusion = f32[65536]{0} fusion(p0), kind=kCustom, calls=fusion,
    backend_config={"fusion_backend_config"
      :{"kind":"__triton_collective", "block_level_fusion_config":{
        "num_warps":"16",
        "output_tiles":[{"sizes":["4096"]}],
        "num_ctas":1,
        "num_stages":1,
        "is_tma_allowed":false,
        "is_warp_specialization_allowed":false}}}
}