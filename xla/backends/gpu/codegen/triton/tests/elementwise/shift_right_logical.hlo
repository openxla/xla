// RUN: fusion_to_triton %s | FileCheck %s
// RUN: triton_test_correctness %s

fusion {
  lhs = u32[8]{0} parameter(0)
  rhs = u32[8]{0} parameter(1)
  ROOT result = u32[8]{0} shift-right-logical(lhs, rhs)
}
// CHECK-DAG: arith.cmpi ult, %{{.*}}, %{{.*}} : tensor<8xi32>
// CHECK-DAG: arith.shrui %{{.*}}, %{{.*}} : tensor<8xi32>
// CHECK: arith.select %{{.*}}, %{{.*}}, %{{.*}} : tensor<8xi1>, tensor<8xi32>

ENTRY main {
  lhs = u32[8]{0} constant({2147483649, 2147483647, 2147483648, 1, 2147483649, 2147483647, 2147483649, 4294967295})
  rhs = u32[8]{0} constant({0, 1, 31, 31, 32, 32, 64, 4294967295})
  ROOT fusion = u32[8]{0} fusion(lhs, rhs), kind=kCustom, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["8"]}],
          "num_warps":"1",
          "num_ctas":"1",
          "num_stages":"1",
          "is_tma_allowed":false}}}
}
