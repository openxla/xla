// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation=false %s 2>&1 | FileCheck %s
// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation %s 2>&1 | FileCheck %s

// CHECK:      xtile.entry_func @triton_fn
// CHECK:      %[[CST:.*]] = arith.constant dense<-1.821973{{.*}}> : tensor<2xf64>
// CHECK:      scf.yield %[[CST]] : tensor<2xf64>

HloModule issue_50004, is_scheduled=true, entry_computation_layout={(f64[2]{0}, f64[2]{0})->f64[5]{0}}

%fused_computation (param_0: f64[2], param_1: f64[2]) -> f64[5] {
  %param_0 = f64[2]{0} parameter(0)
  %param_1 = f64[2]{0} parameter(1)
  %div = f64[2]{0} divide(%param_0, %param_1)
  %cst = f64[1]{0} constant({-0.18219733238220215})
  ROOT %concat = f64[5]{0} concatenate(%param_0, %div, %cst), dimensions={0}
}

ENTRY %entry_computation (param_0: f64[2], param_1: f64[2]) -> f64[5] {
  %param_0 = f64[2]{0} parameter(0)
  %param_1 = f64[2]{0} parameter(1)
  ROOT %fusion = f64[5]{0} fusion(%param_0, %param_1), kind=kCustom, calls=%fused_computation,
    backend_config={
      "operation_queue_id":"0",
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "num_warps":"4",
          "output_tiles":[{"sizes":["2"]}],
          "num_ctas":1,
          "num_stages":1,
          "is_tma_allowed":true,
          "is_warp_specialization_allowed":false,
          "waves_per_eu":0
        }
      },
      "force_earliest_schedule":false,
      "reification_cost":[],
      "device_type":"DEVICE_TYPE_INVALID"
    }
}
