HloModule TestModule, is_scheduled=true

compare {
  p.0.lhs = f32[] parameter(0)
  p.0.rhs = f32[] parameter(1)
  ROOT lt = pred[] compare(p.0.lhs, p.0.rhs), direction=LT
}

ENTRY main {
  param0 = f32[40, 12800] parameter(0)
  ROOT sort = f32[40, 12800] sort(param0), dimensions={1}, to_apply=compare
}

// 4 tiles x 40 = 160 blocks (> core_count) and even tile count, but 3584 / 16384
// = 21.9% element-level out-of-bounds padding (> 12.5%): clustering is skipped.
// CHECK-NOT:   llvm.nvvm.mapa
// CHECK-LABEL: @sort__4(
// CHECK-LABEL: @sort__3(
// CHECK-LABEL: @sort__2(
// CHECK-LABEL: @sort__1(
// CHECK-LABEL: @sort(
// CHECK:       ret void
// CHECK-NOT:   nvvm.cluster_dim
