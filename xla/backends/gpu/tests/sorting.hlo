HloModule TestModule, is_scheduled=true

compare {
  p.0.lhs = f64[] parameter(0)
  p.0.rhs = f64[] parameter(1)
  p.1.lhs = f64[] parameter(2)
  p.1.rhs = f64[] parameter(3)
  p.2.lhs = f64[] parameter(4)
  p.2.rhs = f64[] parameter(5)
