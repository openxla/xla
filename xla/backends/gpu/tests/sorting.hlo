HloModule TestModule, is_scheduled=true

compare {
  p.0.lhs = f32[] parameter(0)
  p.0.rhs = f32[] parameter(1)
  ROOT lt = pred[] compare(p.0.lhs, p.0.rhs), direction=LT
}

ENTRY main {
  param0 = f32[40, 16384] parameter(0)
  ROOT sort = f32[40, 16384] sort(param0), dimensions={1}, to_apply=compare
}

// 14 stages with tile_size 4096. Without clusters (a100, a6000, ROCm), launches
// 6 kernels (initial 12 intra-tile stages, global step 8191, trailing 12
// intra-tile steps, global step 16383, global step 4096, and trailing 12
// intra-tile steps), deduplicated to 5 unique kernels. On Hopper+ (h100_sxm,
// b200), a 2-block cluster covers 13 stages (cluster_tile_size 8192), launching
// 4 kernels deduplicated to 3 unique kernels (@sort__2, @sort__1, @sort).
// CHECK-a100_pcie_80-NOT:      @sort__5(
// CHECK-a100_pcie_80-LABEL:    @sort__4(
// CHECK-a100_pcie_80-LABEL:    @sort__3(
// CHECK-a100_pcie_80-LABEL:    @sort__2(
// CHECK-a100_pcie_80-COUNT-24: call i8 @compare_lt
// CHECK-a100_pcie_80-LABEL:    @sort__1(
// CHECK-a100_pcie_80-LABEL:    @sort(
// CHECK-a100_pcie_80-COUNT-58: call i8 @compare_lt
// CHECK-a100_pcie_80-NOT:      call i8 @compare_lt
// CHECK-a100_pcie_80-NOT:      @sort__5(
// CHECK-a6000-NOT:             @sort__5(
// CHECK-a6000-LABEL:           @sort__4(
// CHECK-a6000-LABEL:           @sort__3(
// CHECK-a6000-LABEL:           @sort__2(
// CHECK-a6000-COUNT-24:        call i8 @compare_lt
// CHECK-a6000-LABEL:           @sort__1(
// CHECK-a6000-LABEL:           @sort(
// CHECK-a6000-COUNT-58:        call i8 @compare_lt
// CHECK-a6000-NOT:             call i8 @compare_lt
// CHECK-a6000-NOT:             @sort__5(
// CHECK-GCN-NOT:               @sort__5(
// CHECK-GCN-LABEL:             @sort__4(
// CHECK-GCN-LABEL:             @sort__3(
// CHECK-GCN-LABEL:             @sort__2(
// CHECK-GCN-COUNT-24:          call i8 @compare_lt
// CHECK-GCN-LABEL:             @sort__1(
// CHECK-GCN-LABEL:             @sort(
// CHECK-GCN-COUNT-58:          call i8 @compare_lt
// CHECK-GCN-NOT:               call i8 @compare_lt
// CHECK-GCN-NOT:               @sort__5(
// CHECK-h100_sxm-NOT:          @sort__3(
// CHECK-h100_sxm-LABEL:        @sort__2(
// CHECK-h100_sxm:              llvm.nvvm.barrier.cluster.arrive.aligned()
// CHECK-h100_sxm-COUNT-2:      call i8 @compare_lt
// CHECK-h100_sxm:              llvm.nvvm.barrier.cluster.arrive.aligned()
// CHECK-h100_sxm-COUNT-24:     call i8 @compare_lt
// CHECK-h100_sxm-NOT:          call i8 @compare_lt
// CHECK-h100_sxm-LABEL:        @sort__1(
// CHECK-h100_sxm-LABEL:        @sort(
// CHECK-h100_sxm:              llvm.nvvm.read.ptx.sreg.cluster.ctaid.x()
// CHECK-h100_sxm-COUNT-58:     call i8 @compare_lt
// CHECK-h100_sxm:              llvm.nvvm.barrier.cluster.arrive.aligned()
// CHECK-h100_sxm-COUNT-4:      call i8 @compare_lt
// CHECK-h100_sxm-NOT:          call i8 @compare_lt
// CHECK-h100_sxm:              "nvvm.cluster_dim"="2,1,1"
// CHECK-b200-NOT:              @sort__3(
// CHECK-b200-LABEL:            @sort__2(
// CHECK-b200:                  llvm.nvvm.barrier.cluster.arrive.aligned()
// CHECK-b200-COUNT-2:          call i8 @compare_lt
// CHECK-b200:                  llvm.nvvm.barrier.cluster.arrive.aligned()
// CHECK-b200-COUNT-24:         call i8 @compare_lt
// CHECK-b200-NOT:              call i8 @compare_lt
// CHECK-b200-LABEL:            @sort__1(
// CHECK-b200-LABEL:            @sort(
// CHECK-b200:                  llvm.nvvm.read.ptx.sreg.cluster.ctaid.x()
// CHECK-b200-COUNT-58:         call i8 @compare_lt
// CHECK-b200:                  llvm.nvvm.barrier.cluster.arrive.aligned()
// CHECK-b200-COUNT-4:          call i8 @compare_lt
// CHECK-b200-NOT:              call i8 @compare_lt
// CHECK-b200:                  "nvvm.cluster_dim"="2,1,1"

// -----

HloModule TestModule, is_scheduled=true

compare {
  p.0.lhs = f32[] parameter(0)
  p.0.rhs = f32[] parameter(1)
  ROOT lt = pred[] compare(p.0.lhs, p.0.rhs), direction=LT
}

ENTRY main {
  param0 = f32[40, 14848] parameter(0)
  ROOT sort = f32[40, 14848] sort(param0), dimensions={1}, to_apply=compare
}

// Non-power-of-2 multi-tile sort splits per-tile so full tiles run the
// unrolled fast path while the trailing partial tile stays rolled. On Hopper+
// (h100_sxm, b200), 4 active tiles launch in 2-block clusters (3 unique
// kernels) and keep the full-tile fast path on tiles 0..2.
// CHECK-a100_pcie_80-LABEL:    @sort__4(
// CHECK-a100_pcie_80-LABEL:    @sort__3(
// CHECK-a100_pcie_80-LABEL:    @sort__2(
// CHECK-a100_pcie_80-COUNT-26: call i8 @compare_lt
// CHECK-a100_pcie_80-NOT:      call i8 @compare_lt
// CHECK-a100_pcie_80-LABEL:    @sort__1(
// CHECK-a100_pcie_80-LABEL:    @sort(
// CHECK-a100_pcie_80-COUNT-62: call i8 @compare_lt
// CHECK-a100_pcie_80-NOT:      call i8 @compare_lt
// CHECK-a6000-LABEL:           @sort__4(
// CHECK-a6000-LABEL:           @sort__3(
// CHECK-a6000-LABEL:           @sort__2(
// CHECK-a6000-COUNT-26:        call i8 @compare_lt
// CHECK-a6000-NOT:             call i8 @compare_lt
// CHECK-a6000-LABEL:           @sort__1(
// CHECK-a6000-LABEL:           @sort(
// CHECK-a6000-COUNT-62:        call i8 @compare_lt
// CHECK-a6000-NOT:             call i8 @compare_lt
// CHECK-GCN-LABEL:             @sort__4(
// CHECK-GCN-LABEL:             @sort__3(
// CHECK-GCN-LABEL:             @sort__2(
// CHECK-GCN-COUNT-26:          call i8 @compare_lt
// CHECK-GCN-NOT:               call i8 @compare_lt
// CHECK-GCN-LABEL:             @sort__1(
// CHECK-GCN-LABEL:             @sort(
// CHECK-GCN-COUNT-62:          call i8 @compare_lt
// CHECK-GCN-NOT:               call i8 @compare_lt
// CHECK-h100_sxm-NOT:          @sort__3(
// CHECK-h100_sxm-LABEL:        @sort__2(
// CHECK-h100_sxm-COUNT-30:     call i8 @compare_lt
// CHECK-h100_sxm-NOT:          call i8 @compare_lt
// CHECK-h100_sxm-LABEL:        @sort__1(
// CHECK-h100_sxm-LABEL:        @sort(
// CHECK-h100_sxm-COUNT-70:     call i8 @compare_lt
// CHECK-h100_sxm-NOT:          call i8 @compare_lt
// CHECK-h100_sxm:              ret void
// CHECK-h100_sxm:              "nvvm.cluster_dim"="2,1,1"
// CHECK-b200-NOT:              @sort__3(
// CHECK-b200-LABEL:            @sort__2(
// CHECK-b200-COUNT-30:         call i8 @compare_lt
// CHECK-b200-NOT:              call i8 @compare_lt
// CHECK-b200-LABEL:            @sort__1(
// CHECK-b200-LABEL:            @sort(
// CHECK-b200-COUNT-70:         call i8 @compare_lt
// CHECK-b200-NOT:              call i8 @compare_lt
// CHECK-b200:                  ret void
// CHECK-b200:                  "nvvm.cluster_dim"="2,1,1"

// -----

HloModule TestModule, is_scheduled=true

compare {
  p.0.lhs = f32[] parameter(0)
  p.0.rhs = f32[] parameter(1)
  ROOT lt = pred[] compare(p.0.lhs, p.0.rhs), direction=LT
}

ENTRY main {
  param0 = f32[8732] parameter(0)
  ROOT sort = f32[8732] sort(param0), dimensions={0}, to_apply=compare
}

// 3 active tiles (4096 elements/tile): padding to 2-block clusters would add
// 1 idle out-of-bounds CTA (+33% blocks), so clustering is skipped on Hopper+.
// CHECK-NOT:   llvm.nvvm.mapa
// CHECK-LABEL: @sort__4(
// CHECK-LABEL: @sort__3(
// CHECK-LABEL: @sort__2(
// CHECK-LABEL: @sort__1(
// CHECK-LABEL: @sort(
// CHECK:       ret void
// CHECK-NOT:   nvvm.cluster_dim

