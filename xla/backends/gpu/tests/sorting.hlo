ENTRY main {
  param0 = f64[80, 2048] parameter(0)
  param1 = f64[80, 2048] parameter(1)
  param2 = f64[80, 2048] parameter(2)
  param3 = f64[80, 2048] parameter(3)
  ROOT sort = (f64[80, 2048], f64[80, 2048], f64[80, 2048], f64[80, 2048]) sort(param0, param1, param2, param3), dimensions={1}, to_apply=compare
}
// The tile size is bounded by shared memory per block: 49152 bytes on the CUDA
// specs gives 1024 elements per operand, 65536 bytes or more on ROCm gives 2048.
// On Hopper+ (h100_sxm, b200), a cluster of 2 blocks sorts all 2048 elements in
// a single kernel using DSMEM and cluster barriers.
// CHECK-PTX-DAG: @shared_0 = private addrspace(3) global [1024 x double] undef{{$}}
// CHECK-PTX-DAG: @shared_1 = private addrspace(3) global [1024 x double] undef{{$}}
// CHECK-PTX-DAG: @shared_2 = private addrspace(3) global [1024 x double] undef{{$}}
// CHECK-PTX-DAG: @shared_3 = private addrspace(3) global [1024 x double] undef{{$}}
// CHECK-GCN-DAG: @shared_0 = private addrspace(3) global [2048 x double] undef{{$}}
// CHECK-GCN-DAG: @shared_1 = private addrspace(3) global [2048 x double] undef{{$}}
// CHECK-GCN-DAG: @shared_2 = private addrspace(3) global [2048 x double] undef{{$}}
// CHECK-GCN-DAG: @shared_3 = private addrspace(3) global [2048 x double] undef{{$}}
// CHECK-a100_pcie_80-LABEL: @sort__2(
// CHECK-a100_pcie_80-LABEL: @sort__1(
// CHECK-a6000-LABEL: @sort__2(
// CHECK-a6000-LABEL: @sort__1(
// CHECK-h100_sxm-NOT: @sort__1(
// CHECK-b200-NOT: @sort__1(
// CHECK-LABEL: @sort(
// CHECK-a100_pcie_80-NOT: llvm.nvvm.mapa
// CHECK-a6000-NOT: llvm.nvvm.mapa
// CHECK-h100_sxm: call range(i32 0, 2) i32 @llvm.nvvm.read.ptx.sreg.cluster.ctaid.x()
// CHECK-h100_sxm: call void @llvm.nvvm.barrier.cluster.arrive.aligned()
// CHECK-h100_sxm: call void @llvm.nvvm.barrier.cluster.wait.aligned()
// CHECK-h100_sxm: call ptr @llvm.nvvm.mapa(ptr addrspacecast (ptr addrspace(3) @shared_0 to ptr), i32 %{{.*}})
// CHECK-h100_sxm: "nvvm.cluster_dim"="2,1,1"
// CHECK-b200: call range(i32 0, 2) i32 @llvm.nvvm.read.ptx.sreg.cluster.ctaid.x()
// CHECK-b200: call void @llvm.nvvm.barrier.cluster.arrive.aligned()
// CHECK-b200: call void @llvm.nvvm.barrier.cluster.wait.aligned()
// CHECK-b200: call ptr @llvm.nvvm.mapa(ptr addrspacecast (ptr addrspace(3) @shared_0 to ptr), i32 %{{.*}})
// CHECK-b200: "nvvm.cluster_dim"="2,1,1"

// -----

HloModule TestModule, is_scheduled=true

compare {
  p.0.lhs = f64[] parameter(0)
  p.0.rhs = f64[] parameter(1)
  ROOT lt = pred[] compare(p.0.lhs, p.0.rhs), direction=LT
}

ENTRY main {
  param0 = f64[3072] parameter(0)
  ROOT sort = f64[3072] sort(param0), dimensions={0}, to_apply=compare
}

// The sort dimension fits in a single partial tile, so only the rolled bounds
// checked compare loop body is emitted (2 comparisons per step): 1 rolled flip
// step and 1 rolled inner merge step = 2 steps (4 calls).
// CHECK-LABEL: @sort(
// CHECK-COUNT-4: call i8 @compare_lt(
// CHECK-NOT:     call i8 @compare_lt(

