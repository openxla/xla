compare {
  p.0.lhs = f32[] parameter(0)
  p.0.rhs = f32[] parameter(1)
  ROOT lt = pred[] compare(p.0.lhs, p.0.rhs), direction=LT
}

ENTRY main {
  param0 = f32[16384] parameter(0)
  ROOT sort = f32[16384] sort(param0), dimensions={0}, to_apply=compare
}

// 4 unclustered tiles <= SM core_count (132 on H100, 148 on B200): clustering is
// skipped when unclustered blocks do not saturate the GPU.
// CHECK-NOT:   llvm.nvvm.mapa
// CHECK-LABEL: @sort__4(
// CHECK-LABEL: @sort__3(
// CHECK-LABEL: @sort__2(
// CHECK-LABEL: @sort__1(
// CHECK-LABEL: @sort(
// CHECK:       ret void
// CHECK-NOT:   nvvm.cluster_dim

